#!/usr/bin/env python3
"""Run a command with a selected proxy; no third-party dependencies."""
import os
import re
from pathlib import Path
import sys
from urllib.parse import urlsplit, urlunsplit

KEYS = ('http_proxy', 'https_proxy', 'all_proxy', 'ws_proxy', 'wss_proxy')
DEFAULT_NO_PROXY = 'localhost,127.0.0.1,::1,127.0.0.0/8,192.168.0.0/16'


def normalize(value):
    try:
        url = urlsplit(value)
        if url.scheme not in ('http', 'https', 'socks5', 'socks5h') or not url.hostname or not url.port:
            raise ValueError
        if url.path not in ('', '/') or any(c.isspace() for c in value):
            raise ValueError
        return urlunsplit((url.scheme, url.netloc, '', '', ''))
    except ValueError:
        raise ValueError('Invalid proxy URL: expected http(s)://host:port or socks5(h)://host:port') from None


def main():
    args = sys.argv[1:]
    directory = Path.home() / '.proxy487'
    if args == ['--init']:
        directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        target = directory / 'proxy-list.txt'
        if not target.exists():
            with os.fdopen(os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), 'w') as stream:
                stream.write('# One proxy URL per line; credentials must be URL-encoded.\n')
        print(f'Add your proxy URL to {target}')
        return
    if not args or args == ['--help']:
        print('Usage: proxy487 [--] COMMAND [ARG ...]\n       proxy487 --init')
        return 0 if args else 2
    if args[0] == '--':
        args = args[1:]
    if not args:
        raise ValueError('A command is required')
    try:
        proxies = [normalize(line.strip()) for line in (directory / 'proxy-list.txt').read_text().splitlines()
                   if line.strip() and not line.lstrip().startswith('#')]
    except FileNotFoundError:
        raise ValueError('Run proxy487 --init, then add a proxy URL to ~/.proxy487/proxy-list.txt') from None
    if not proxies:
        raise ValueError('No proxies configured in ~/.proxy487/proxy-list.txt')
    chosen = directory / 'chosen'
    host = chosen.read_text().strip() if chosen.exists() else ''
    proxy = next((p for p in proxies if not host or urlsplit(p).hostname == host), None)
    if proxy is None:
        raise ValueError('Selected host is absent from ~/.proxy487/proxy-list.txt')
    env = os.environ.copy()
    defaults = directory / 'default.env'
    try:
        lines = defaults.read_text().splitlines()
    except FileNotFoundError:
        lines = []
    for number, line in enumerate(lines, 1):
        if not line.strip() or line.lstrip().startswith('#'):
            continue
        key, separator, value = line.partition('=')
        key = key.strip()
        if not separator or not re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*', key) or '\0' in value:
            raise ValueError(f'Invalid default.env entry on line {number}')
        env.setdefault(key, value.strip())
    for key in KEYS:
        env[key] = env[key.upper()] = proxy
    bypass = env.get('no_proxy', env.get('NO_PROXY', DEFAULT_NO_PROXY))
    env['no_proxy'] = env['NO_PROXY'] = bypass
    os.execvpe(args[0], args, env)


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, ValueError) as error:
        # Do not echo URLs or arbitrary OS errors: they can contain credentials.
        print(str(error) if isinstance(error, ValueError) else 'Cannot read configuration or execute command', file=sys.stderr)
        sys.exit(1)
